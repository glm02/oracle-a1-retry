# Copie ce fichier en config.env (ignoré par git) et remplis tes valeurs.
# Récupère les OCID avec la console Oracle ou l'OCI CLI :
#   oci iam availability-domain list -c <tenancy_ocid>
#   oci compute image list -c <tenancy_ocid> --operating-system "Canonical Ubuntu" --operating-system-version "24.04" --shape "VM.Standard.A1.Flex"
#   oci network subnet list -c <tenancy_ocid>

OCI_BIN=oci                              # ou le chemin complet vers oci(.exe) si pas dans le PATH
COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxx  # OCID de ta tenancy ou d'un compartiment
AVAILABILITY_DOMAIN=xxxx:EU-PARIS-1-AD-1
IMAGE_ID=ocid1.image.oc1.xxxxx
SUBNET_ID=ocid1.subnet.oc1.xxxxx
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... toi@tonpc"
DISPLAY_NAME=mon-instance-a1

OCPUS=4
MEMORY_GB=24
BOOT_GB=100

# Optionnel : alerte Telegram envoyée dès que l'instance est prête.
# Crée un bot avec @BotFather (le token), récupère ton chat id avec
# @userinfobot. Laisse vide pour désactiver.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
